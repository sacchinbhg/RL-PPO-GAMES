 NATIVE_DATA_NAMES := $(basename $(notdir $(WASM_DATA_ASM_SRCS))) contest_ai_scripts mystery_event_script_cmd_table multiboot_pokemon_colosseum multiboot_ereader multiboot_berry_glitch_fix
